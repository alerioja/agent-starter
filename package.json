{
  "name": "agent-starter",
  "version": "1.0.0",
  "description": "The minimal production agent loop from the AI Agents for Beginners course (Module 02).",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "tsx --env-file=.env src/run.ts",
    "start:runner": "tsx --env-file=.env src/run-with-runner.ts",
    "dev": "tsx watch --env-file=.env src/run.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
